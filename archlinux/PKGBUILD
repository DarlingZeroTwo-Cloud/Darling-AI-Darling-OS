# Maintainer: DarlingZeroTwo <darling@darlingos.local>
# Darling AI for Darling OS —— Arch Linux 专属发行版（.pkg.tar.zst）
pkgname=darling-ai-darling-os
pkgver=4.1.9
pkgrel=1
pkgdesc="Darling AI for Darling OS：悬浮球快速 AI 对话助手（官方模型 02，Hyprland 专属）"
arch=('x86_64')
url="https://github.com/DarlingZeroTwo-Cloud/Darling-AI-Darling-OS"
license=('MIT')
depends=('gtk3' 'python' 'python-requests' 'tesseract' 'tesseract-data-chi_sim' 'grim' 'hyprland')
optdepends=('dsh: DeepSeek Harness 本地内核（可选安装）')
source=("darling-ai-bundle.tar.gz" "darling-ai-launcher" "darling-ai-toggle" "darling-ai.desktop" "darling-ai.service" "hyprland-darling-ai.conf" "darling-ai.svg")
noextract=()
md5sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  # 主程序 + 后端 + 资源
  install -d "$pkgdir/usr/lib/darling-ai"
  tar -xzf "$srcdir/darling-ai-bundle.tar.gz" -C "$pkgdir/usr/lib/darling-ai/"

  # 启动器
  install -Dm755 "$srcdir/darling-ai-launcher" "$pkgdir/usr/bin/darling-ai"

  # 快捷键唤起脚本
  install -Dm755 "$srcdir/darling-ai-toggle" "$pkgdir/usr/bin/darling-ai-toggle"

  # 桌面入口
  install -Dm644 "$srcdir/darling-ai.desktop" "$pkgdir/usr/share/applications/darling-ai.desktop"

  # 用户级 systemd 常驻服务（开机自启 + 崩溃自动重启）
  install -Dm644 "$srcdir/darling-ai.service" "$pkgdir/usr/lib/systemd/user/darling-ai.service"

  # Hyprland 集成配置（用户可 include 或复制到 ~/.config/hypr/）
  install -Dm644 "$srcdir/hyprland-darling-ai.conf" "$pkgdir/usr/share/darling-ai/hyprland-darling-ai.conf"

  # 图标
  install -Dm644 "$srcdir/darling-ai.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/darling-ai.svg"
}
